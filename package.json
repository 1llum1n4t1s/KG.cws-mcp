{
  "name": "@kagayoi/cws-mcp",
  "version": "2.0.9",
  "mcpName": "io.github.1llum1n4t1s/cws",
  "description": "MCP server for Chrome Web Store extension management (V2 API)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cws-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun --no-env-file --no-install --bun run tsc",
    "start": "bun --no-env-file --no-install dist/index.js",
    "dev": "bun --no-env-file --no-install src/index.ts"
  },
  "keywords": [
    "mcp",
    "chrome-web-store",
    "chrome-extension",
    "publish",
    "model-context-protocol"
  ],
  "author": "1llum1n4t1s",
  "contributors": [
    "mikusnuz (original author of cws-mcp)"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/KG.cws-mcp.git"
  },
  "homepage": "https://github.com/1llum1n4t1s/KG.cws-mcp#readme",
  "bugs": {
    "url": "https://github.com/1llum1n4t1s/KG.cws-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
